FROM docker.io/library/golang:1.24 AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/quanto ./cmd/quanto

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/quanto /quanto
ENTRYPOINT ["/quanto"]
